[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "{{ version }}"
description = "FastMCP server for {{ server_name }}"
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "mcp>=1.3.0,<2",
    "httpx>=0.27.0",
    "python-dotenv>=1.0.0",
]
