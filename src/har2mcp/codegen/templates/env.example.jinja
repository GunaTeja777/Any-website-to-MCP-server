# Environment configuration for {{ server_name }} MCP Server

# Base API endpoint URL
API_BASE_URL={{ base_url }}

{% for cred in auth_spec.credentials %}
# {{ cred.description or cred.name }} (Location: {{ cred.location.value }})
{{ cred.env_var_name }}={{ cred.placeholder or "your_" + cred.env_var_name.lower() }}
{% endfor %}
