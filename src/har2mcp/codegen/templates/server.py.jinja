async def make_request_with_retry(
    method: str,
    path: str,
    params: dict[str, Any] | None = None,
    json_data: dict[str, Any] | None = None,
    max_retries: int = 3,
    initial_backoff: float = 0.5,
) -> Any:
    """Execute HTTP request with exponential backoff on transient network and server errors."""
    url = f"{API_BASE_URL}{path}"
    headers = {
        "Accept": "application/json, text/plain, */*",
        "User-Agent": "{{ server_name }}-MCP/1.0",
        **get_auth_headers(),
    }
    cookies = get_auth_cookies()
    query_params = {**get_auth_query_params(), **(params or {})}
    clean_params = {k: v for k, v in query_params.items() if v is not None}

    last_exc: Exception | None = None
    for attempt in range(max_retries + 1):
        try:
            async with httpx.AsyncClient(
                timeout=30.0,
                cookies=cookies,
                follow_redirects=True,
            ) as client:
                response = await client.request(
                    method=method,
                    url=url,
                    params=clean_params,
                    json=json_data if json_data is not None else None,
                    headers=headers,
                )

                if response.status_code in {429, 502, 503, 504} and attempt < max_retries:
                    retry_after = response.headers.get("Retry-After")
                    delay = (
                        float(retry_after)
                        if retry_after and retry_after.isdigit()
                        else initial_backoff * (2**attempt)
                    )
                    await asyncio.sleep(delay)
                    continue

                response.raise_for_status()

                try:
                    return response.json()
                except Exception:
                    return response.text

        except (httpx.ConnectError, httpx.TimeoutException) as exc:
            last_exc = exc
            if attempt < max_retries:
                await asyncio.sleep(initial_backoff * (2**attempt))
                continue
            raise RuntimeError(
                f"Failed to connect to {url} after {max_retries} retries: {exc}"
            ) from exc
        except httpx.HTTPStatusError as exc:
            error_detail = exc.response.text[:500] if exc.response.text else "No response body"
            raise RuntimeError(
                f"HTTP {exc.response.status_code} calling {method} {url}: {error_detail}"
            ) from exc
        except Exception as exc:
            raise RuntimeError(f"Unexpected error calling {method} {url}: {exc}") from exc

    if last_exc:
        raise last_exc
    raise RuntimeError(f"Request failed after {max_retries} retries")

